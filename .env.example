# SafeBite monthly AI analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Monthly scheduler
SAFE_BITE_MONTHLY_AUTO_RUN=true
SAFE_BITE_MONTHLY_RUN_DAY=1
SAFE_BITE_MONTHLY_RUN_HOUR_UTC=2

# Email (SMTP)
SAFEBITE_SMTP_HOST=
SAFEBITE_SMTP_PORT=587
SAFEBITE_SMTP_USERNAME=
SAFEBITE_SMTP_PASSWORD=
SAFEBITE_FROM_EMAIL=
SAFEBITE_SMTP_USE_TLS=true

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Blockchain
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
